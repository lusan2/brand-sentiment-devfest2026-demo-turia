          "rawSql": "SELECT CASE COALESCE(entity,'') WHEN 'TURIA' THEN 'Turia' WHEN 'amstel_oro' THEN 'Amstel Oro' WHEN 'san_miguel_selecta' THEN 'San Miguel Selecta' WHEN '1906' THEN '1906 Reserva Especial' WHEN 'mahou_maestra' THEN 'Mahou Maestra' WHEN 'alhambra_reserva' THEN 'Alhambra Reserva 1925' WHEN 'cruzcampo_tostada' THEN 'Cruzcampo Gran Reserva' WHEN 'moritz_epidor' THEN 'Moritz Epidor' ELSE 'Otro' END AS metric, COUNT(*) AS value FROM sentiment_mentions WHERE brand = 'TURIA' AND market = 'ES' AND parse_error = false AND mention_type IN ('brand','competitor') GROUP BY 1 ORDER BY value DESC LIMIT 10",
