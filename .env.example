NEWSAPI_KEY=

# Anthropic Claude API — obtener en console.anthropic.com
ANTHROPIC_API_KEY=

# YouTube Data API v3 — obtener en console.cloud.google.com
YOUTUBE_API_KEY=

# Reddit OAuth2 (app tipo 'script' en https://www.reddit.com/prefs/apps)
# Google News RSS / Bing News RSS / Arctic Shift / GDELT — no necesitan credenciales

# CORS — orígenes permitidos para la API de exportación CSV
# En producción sustituir por el host real de Grafana: https://grafana.ejemplo.com
CORS_ORIGINS=http://localhost:3000

# PostgreSQL — cambiar contraseña antes de desplegar en producción
POSTGRES_DB=sentiment
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=changeme

# Grafana — cambiar usuario y contraseña antes de desplegar en producción
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme
# Intervalos de ejecución (minutos)
REDDIT_INTERVAL_MINUTES=1440
NEWS_INTERVAL_MINUTES=1440
YOUTUBE_INTERVAL_MINUTES=1440

# Reddit OAuth2 (app tipo 'script' en https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="brand-sentiment-bot/1.0 by u/TU_USUARIO_REDDIT"

# ControlTab — navegador real (X/Twitter + Reddit web + Bluesky + Birrapedia)
CONTROLTAB_MCP_URL=
CONTROLTAB_BRANDS=TURIA
CONTROLTAB_INTERVAL_MINUTES=720
CONTROLTAB_REQUEST_DELAY=2.0
CONTROLTAB_RENDER_DELAY=5.0
